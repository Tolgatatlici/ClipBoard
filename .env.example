# Sunucu
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Redis (docker compose ile gelir)
REDIS_URL=redis://localhost:6379

# Dosya depolama: `local` (sunucu diski, geliştirme için) veya `s3`
STORAGE_DRIVER=local
STORAGE_DIR=./data/files
# Yerel sürücü için imza anahtarı (en az 32 karakter); boşsa açılışta rastgele üretilir
FILE_SIGNING_SECRET=

# S3 uyumlu depolama (STORAGE_DRIVER=s3; lokalde MinIO, üretimde Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=clipboard-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
