# Sunucu
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# IP başına dakikadaki istek sınırları
RATE_LIMIT_MAX=120
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_OPEN_MAX=20
RATE_LIMIT_FILE_MAX=20
RATE_LIMIT_PAIRING_MAX=10

# Redis (docker compose ile gelir)
REDIS_URL=redis://localhost:6379

# Dosya depolama: `local` (sunucu diski, geliştirme için) veya `s3`
STORAGE_DRIVER=local
STORAGE_DIR=./data/files
# Yerel sürücü için imza anahtarı (en az 32 karakter); boşsa açılışta rastgele üretilir
FILE_SIGNING_SECRET=

# S3 uyumlu depolama (STORAGE_DRIVER=s3; lokalde SeaweedFS, üretimde ör. Cloudflare R2)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=clipboard-files
S3_ACCESS_KEY_ID=clipboard
S3_SECRET_ACCESS_KEY=clipboard-dev-secret

# Derlenmiş arayüzü sunucudan sunmak için (Docker imajında /app/public)
# STATIC_DIR=./apps/web/dist

# Doğrudan (P2P) dosya aktarımı için WebRTC ICE sunucuları (JSON). Boşsa yalnızca aynı
# ağdaki cihazlar doğrudan bağlanır. Örnek:
# RTC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Gözlemlenebilirlik (isteğe bağlı)
# METRICS_TOKEN=          # en az 16 karakter; /metrics için Bearer anahtarı
# SENTRY_DSN=             # sunucu hataları, istek ayrıntıları olmadan
